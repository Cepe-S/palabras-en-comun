{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "palabras-en-comun-turn",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  // Origen del sitio publicado. localhost se acepta siempre, para el servidor de desarrollo.
  "vars": {
    "ALLOWED_ORIGINS": "https://cepe-s.github.io"
  },
  "secrets": {
    "required": ["TURN_KEY_ID", "TURN_KEY_API_TOKEN"]
  }
}
